@page "/add"
@using Books.Shared.Models
@inject HttpClient Http

<h3>Add</h3>

<EditForm Model="book" OnValidSubmit="Submit" FormName="AddBook">
    <DataAnnotationsValidator />
        <div>
            <label>
                Name:
                <InputText @bind-Value="book.Name"/>
            </label>
        </div>
        <div>
            <label>
                Chapter:
            <InputNumber @bind-Value="book.chapter" />
            </label>
        </div>
        <div>
            <label>
                Description: 
                <InputTextArea @bind-Value="book.comment"/>
            </label>
        </div>
        <div>
            <button type="submit">Submit</button>
        </div>
</EditForm>

@code {
    private Books book = new Books();

    private async Task Submit()
    {
        var response = await Http.PostAsJsonAsync("https://api.sophia-dukhota.com/books", book);
        Console.WriteLine($"Name {book.Name}, chapter: {book.chapter}, comment: {book.comment}");
        book = new Books();
    }
}
